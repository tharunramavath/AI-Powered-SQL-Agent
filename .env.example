# ============================================================
# AI SQL Agent - environment configuration
# Copy to .env and fill in values.
# ============================================================

# --- App ---
APP_NAME=ai-sql-agent
ENV=dev
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Security ---
# Comma-separated API keys accepted by the API (Authorization: Bearer <key>).
# Leave empty to disable auth (dev only).
API_KEYS=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
# Maximum total prompt + completion tokens for the agent's generator LLM
LLM_MAX_TOKENS=4096

# --- Agent ---
MAX_SQL_RETRIES=3
MAX_ROWS=500
QUERY_TIMEOUT_SECONDS=30
EXPENSIVE_QUERY_THRESHOLD=1000000   # approximate rows scanned before human approval
REQUIRE_APPROVAL=false

# --- Default datasource (used when no datasource_id supplied) ---
# SQLAlchemy URL. Examples:
#   postgresql+psycopg://user:pass@localhost:5432/db
#   mysql+pymysql://user:pass@localhost:3306/db
#   sqlite:///./data.db
DATASOURCE_URL=
DATASOURCE_ID=default

# --- Redis cache ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
CACHE_ENABLED=false

# --- Vector store (Qdrant) ---
VECTOR_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_PATH=./.qdrant        # used when QDRANT_URL is empty (embedded local mode)
QDRANT_API_KEY=
QDRANT_COLLECTION=schema_docs
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Memory / persistence ---
MEMORY_BACKEND=memory        # memory | postgres
POSTGRES_CHECKPOINT_DSN=

# --- Observability (LangFuse Cloud) ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Create a project at https://cloud.langfuse.com and copy the public/secret keys.
# Set LANGFUSE_ENABLED=true to trace LLM calls, agent runs, and eval scores.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_RELEASE=

# --- Guardrails ---
# Input gate blocks prompt-injection / unsafe input before planning.
INPUT_GUARDRAILS_ENABLED=true
# Output gate verifies the summary is faithful to the returned rows.
OUTPUT_GUARDRAILS_ENABLED=true
# When true, also block requests for PII/sensitive data (SSN, credit cards, ...).
GUARDRAIL_PII_BLOCK=false
